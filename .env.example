# Names only: copy to .env and fill in local values. Never commit real values.

# Local Postgres for `pnpm dev` (overrides wrangler.jsonc localConnectionString).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Direct connection string for `pnpm db:migrate`.
MIGRATION_DATABASE_URL=

# Optional admin connection (CREATEDB) that replaces the embedded test server.
TEST_DATABASE_URL=
